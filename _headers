# رؤوس النشر على Cloudflare Pages.
#
# الترتيب مقصود: القاعدة العامة أوّلًا ثم ما يخصّصها.
#
# سياسة المحتوى مُجرَّبة لا مُخمَّنة: شُغّلت الفحوص كلّها تحتها، ثمّ رُصدت
# الصفحتان بحثًا عن حجبٍ صامت — صفر انتهاك. و'unsafe-inline' للنصوص لازمة
# لأنّ وحدات الصفحتين مكتوبة داخلهما؛ ومع ذلك تبقى الفائدة الكبرى قائمة:
# لا يُحمَّل نصٌّ من نطاقٍ آخر، ولا يُرسَل شيءٌ إلى نطاقٍ آخر.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# الصفحتان وعامل الخدمة لا يُخزَّنان: التحديث يجب أن يصل من أوّل فتحة.
/index.html
  Cache-Control: no-cache

/admin.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

# ما يحمل ?v= يُبطله رقم النسخة، فيصحّ تخزينه طويلًا.
/assets/*
  Cache-Control: public, max-age=3600

# الخطوط والصور لا تتغيّر إلا باسمٍ جديد، فتُخزَّن سنة.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/brand/*
  Cache-Control: public, max-age=31536000, immutable

/assets/icons/*
  Cache-Control: public, max-age=31536000, immutable

/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable
